# .env.local にコピーして使う（.env.local はコミットしない）
# 値は `terraform -chdir=infra output -raw api_endpoint` で確認できる。末尾に / を付けない
NEXT_PUBLIC_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com

# ログイン（Cognito）。値は `terraform -chdir=infra output -raw <名前>` で確認できる。末尾に / を付けない
# cognito_issuer
NEXT_PUBLIC_COGNITO_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_xxxxxxxxx
# cognito_domain_url
NEXT_PUBLIC_COGNITO_DOMAIN_URL=https://moodlog-xxxxxxxx.auth.ap-northeast-1.amazoncognito.com
# cognito_client_id
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
